{
  "name": "sen-ai-desktop",
  "productName": "SEN AI Desktop",
  "private": true,
  "version": "1.0.0",
  "description": "SEN AI Dynamic Lake Notch & Windows System Tray Overlay Assistant",
  "author": "SEN AI Team",
  "main": "index.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron",
    "lint": "tsc --noEmit",
    "electron:build": "npm run build && npx tsc server.ts --target es2022 --module commonjs --outDir . && electron-builder --win --x64"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.sen.desktop",
    "productName": "SEN AI Desktop",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "index.cjs",
      "electron-main.cjs",
      "electron-preload.cjs",
      "server.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
